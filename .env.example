# Caddy service environment. Set a DNS hostname and a bcrypt hash from caddy hash-password.
APP_HOST=
OWNER_PASSWORD_HASH=
# Frontend build environment when using the gateway
NEXT_PUBLIC_API_URL=/api/v1
# Optional backend overrides (export them in the backend process environment).
# DATABASE_URL=sqlite:////absolute/path/to/private/market.db
# CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Private backend + Caddy service environments, same random secret on both.
INTEGRATIONS_GATEWAY_SECRET=
# Backend only. Key and ciphertext must be stored separately.
THNDR_ENCRYPTION_KEY=
THNDR_REDIRECT_URI=
# THNDR_PRIVATE_DIR=/absolute/private/directory

# Private backend environment, optional. Keep the key on the backend.
AI_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini-2026-03-17
AI_DAILY_BUDGET_USD=0.25
AI_MONTHLY_BUDGET_USD=3
AI_MAX_OUTPUT_TOKENS=320
AI_REQUEST_TIMEOUT=10
AI_CACHE_TTL_SECONDS=900
AI_MIN_ANALYSIS_INTERVAL_SECONDS=60
AI_REQUESTS_PER_MINUTE=6
# Set both for a custom model or updated standard prices, in USD per 1M tokens.
# AI_INPUT_USD_PER_MILLION=
# AI_OUTPUT_USD_PER_MILLION=
# AI_LEDGER_PATH=/private/persistent/ai_usage.sqlite3

# Scanner worker and API must share a private DATABASE_URL.
SCANNER_ENABLED=false
# 0 = completed session. 60/300/900/1800 require a licensed feed and are unavailable here.
SCANNER_INTERVAL_SECONDS=0
SCANNER_MAX_CONCURRENCY=1
SCANNER_MAX_SYMBOLS_PER_SCAN=500
SCANNER_AI_ENABLED=false
SCANNER_MAX_AI_REQUESTS_PER_SCAN=2
SCANNER_LEASE_SECONDS=60
SCANNER_HEARTBEAT_SECONDS=5
SCANNER_JOB_TIMEOUT_SECONDS=300
SCANNER_THNDR_MIN_INTERVAL_SECONDS=300
SCANNER_HISTORY_RETENTION_DAYS=30
ALERT_COOLDOWN_SECONDS=21600
# External channels are opt-in. Pair a destination in the protected owner UI.
TELEGRAM_ENABLED=false

# Phase 6 worker processes use the same private DATABASE_URL as the API.
# Start app.workers.paper_worker and app.workers.backtest_worker separately.
# Virtual automation is disabled per new account. Configure simulation costs
# explicitly in the account or backtest form. No brokerage keys are used.

# Phase 7. Store these in the private server/worker environment only.
# APP_HOST=egx.example.com
WEB_PUSH_ENABLED=false
# NOTIFICATION_ENCRYPTION_KEY=
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_USER_ID=123456789
# VAPID_PRIVATE_KEY=
# VAPID_PUBLIC_KEY=
# VAPID_SUBJECT=mailto:owner@example.com
EOD_IMPORT_ENABLED=false
# EOD_IMPORT_DIRECTORY=/var/lib/egx/inbox
EOD_IMPORT_INTERVAL_SECONDS=300
EOD_IMPORT_MAX_PER_DAY=20
EOD_IMPORT_PAPER_FOLLOW=false

# Phase 8: trading mode and scanner-draft opt-in live in owner settings.
# No environment variable enables official brokerage proposal submission.

# EODHD key-encryption override for private deployments. Set a Fernet key here
# or retain the existing notification encryption key for domain-separated derivation.
# Add the provider API token through the authenticated /data/providers page.
# EODHD_ENCRYPTION_KEY=
