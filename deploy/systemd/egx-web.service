[Unit]
Description=Private EGX Next.js frontend
After=network.target

[Service]
Type=simple
User=egx
Group=egx
WorkingDirectory=/opt/egx/frontend
Environment=NODE_ENV=production
ExecStart=/opt/egx/frontend/node_modules/.bin/next start --hostname 127.0.0.1 --port 3000
Restart=on-failure
RestartSec=5s
TimeoutStopSec=35s
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=-/opt/egx/frontend/.next/cache
MemoryMax=768M

[Install]
WantedBy=multi-user.target
